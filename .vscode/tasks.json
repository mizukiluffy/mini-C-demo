{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件（32位静态链接 EasyX）",
            "command": "C:\\Program Files (x86)\\Dev-Cpp\\MinGW64\\bin\\g++.exe",
            "args": [
                "-m32",
                "-static",
                "-mwindows",
                "-fexec-charset=GBK",
                "-g",
                "-I${workspaceFolder}\\easyx\\include",
                "${file}",
                "-L${workspaceFolder}\\easyx\\lib32",
                "-leasyx",
                "-limm32",
                "-o",
                "${workspaceFolder}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "32位 TDM-GCC 4.7.1 + 静态链接；源码UTF-8，-fexec-charset=GBK 保证EasyX中文正常；源码位于 src/，依赖 easyx/"
        }
    ],
    "version": "2.0.0"
}
